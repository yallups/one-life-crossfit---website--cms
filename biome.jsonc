{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/next"],
  "files": {
    "includes": [
      "**/*",
      "!**/node_modules/**",
      "!**/.idea/**",
      "!**/.next/**",
      "!**/.sanity-config/**",
      "!**/.turbo/**",
      "!**/.vscode/**",
      "!**/.sanity/**",
      "!**/dist/**"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "recommended": false,
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "off",
        "noConsole": "off",
        "noSelfCompare": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "useTemplate": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noImgElement": "off"
      },
      "a11y": {
        "useIframeTitle": "off"
      },
      "correctness": {
        "noInvalidPositionAtImportRule": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "off"
      }
    }
  }
}
